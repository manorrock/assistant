<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.web.WebView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane fx:id="root" xmlns="http://javafx.com/javafx/17" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.manorrock.assistant.desktop.MainWindowController">
   <center>
      <VBox spacing="10">
         <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
         </padding>
         <WebView fx:id="responseArea" VBox.vgrow="ALWAYS"/>
         <TextArea fx:id="requestArea" wrapText="true" prefHeight="100" promptText="Type your message here..."/>
         <HBox spacing="10">
             <Button fx:id="sendButton" text="Send" onAction="#handleSendAction" maxWidth="Infinity"/>
         </HBox>
      </VBox>
   </center>
   <bottom>
      <ProgressBar fx:id="progressBar" prefWidth="1000" />
   </bottom>
</BorderPane>
