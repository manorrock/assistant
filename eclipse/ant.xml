<?xml version="1.0" encoding="UTF-8"?>
<project default="plugin_export" name="build">
	<!-- Add properties for debug and tracing -->
	<property environment="env"/>
	<property name="buildDirectory" location="target"/>
	<property name="plugin.destination" location="${buildDirectory}"/>
	<property name="plugin.id" value="com.manorrock.assistant.eclipse"/>
	
	<!-- Load build.properties file -->
	<property file="build.properties"/>
	
	<!-- Derive source and output directories from build.properties if possible -->
	<property name="src.dir" location="${source..}"/>
	<property name="output.dir" location="${output..}"/>
	<property name="build.dir" location="${buildDirectory}/classes"/>
	
	<target name="init">
		<!-- Ensure target directory exists -->
		<mkdir dir="${buildDirectory}" />
		<mkdir dir="${build.dir}" />
		<echo message="Build directory: ${buildDirectory}"/>
		<echo message="Plugin destination: ${plugin.destination}"/>
		<echo message="Eclipse home: ${env.ECLIPSE_HOME}"/>
		<echo message="Source directory: ${src.dir}"/>
		<echo message="Output directory: ${output.dir}"/>
		<echo message="bin.includes: ${bin.includes}"/>
	</target>
	
	<target name="compile" depends="init">
		<echo message="Compiling plugin sources..."/>
		
		<!-- Set up classpath with Eclipse plugins and additional bundles -->
		<path id="plugin.classpath">
			<fileset dir="${env.ECLIPSE_HOME}/plugins">
				<include name="**/*.jar"/>
			</fileset>
			<!-- Include lib dependencies from build.properties -->
			<fileset dir="lib" erroronmissingdir="false">
				<include name="**/*.jar"/>
			</fileset>
		</path>
		
		<!-- Compile the source code -->
		<javac srcdir="src" destdir="${build.dir}" 
			   includeantruntime="false" debug="true" 
			   failonerror="false">
			<classpath refid="plugin.classpath"/>
		</javac>
		
		<!-- Copy non-Java resources from source -->
		<copy todir="${build.dir}" failonerror="false">
			<fileset dir="src" excludes="**/*.java"/>
		</copy>
		
		<!-- Copy resources mentioned in bin.includes -->
		<echo message="Copying resources from bin.includes..."/>
		<copy todir="${build.dir}" failonerror="false">
			<!-- Parse bin.includes and copy each entry -->
			<fileset dir=".">
				<include name="plugin.xml"/>
				<include name="META-INF/**"/>
				<include name="OSGI-INF/**"/>
				<include name="icons/**"/>
			</fileset>
		</copy>
		
		<!-- Copy required libraries -->
		<copy todir="${build.dir}/lib" failonerror="false">
			<fileset dir="lib">
				<include name="*.jar"/>
			</fileset>
		</copy>
	</target>
	
	<target name="jar" depends="compile">
		<echo message="Creating plugin jar file..."/>
		<jar destfile="${buildDirectory}/${plugin.id}.jar">
			<fileset dir="${build.dir}"/>
			<!-- Include any root files specified in bin.includes -->
			<fileset dir="." includes="plugin.xml" failonerror="false"/>
			<fileset dir="." includes="META-INF/**" failonerror="false"/>
			<fileset dir="." includes="OSGI-INF/**" failonerror="false"/>
			<fileset dir="." includes="icons/**" failonerror="false"/>
			
			<!-- Create OSGi manifest attributes -->
			<manifest>
				<attribute name="Bundle-SymbolicName" value="${plugin.id}"/>
				<attribute name="Bundle-Version" value="1.0.0"/>
				<attribute name="Bundle-Name" value="Manorrock Assistant Eclipse Plugin"/>
				<attribute name="Bundle-Vendor" value="Manorrock"/>
			</manifest>
		</jar>
		<echo message="Plugin jar created at: ${buildDirectory}/${plugin.id}.jar"/>
		<exec executable="ls" failonerror="false">
			<arg value="-la"/>
			<arg value="${buildDirectory}"/>
		</exec>
	</target>
	
	<target name="plugin_export" depends="jar">
		<!-- Export the Eclipse plugin using PDE -->
		<echo message="Starting plugin export..."/>
		
		<pde.exportPlugins 
			destination="${plugin.destination}"
			exportSource="false" 
			exportType="zip" 
			filename="Manorrock-Assistant-Eclipse.zip" 
			plugins="${plugin.id}" 
			useJARFormat="false"/>
			
		<echo message="Plugin export completed"/>
		
		<!-- List the output directory to verify the export -->
		<exec executable="ls" failonerror="false">
			<arg value="-la"/>
			<arg value="${plugin.destination}"/>
		</exec>
		
		<!-- If the zip wasn't created, create a fallback one with the JAR we built -->
		<echo message="Creating fallback zip if needed..."/>
		<available file="${plugin.destination}/Manorrock-Assistant-Eclipse.zip" property="zip.exists"/>
		<antcall target="create-fallback-zip" unless="zip.exists"/>
	</target>
	
	<target name="create-fallback-zip">
		<echo message="Creating fallback zip with plugin jar..."/>
		<zip destfile="${plugin.destination}/Manorrock-Assistant-Eclipse.zip">
			<fileset dir="${buildDirectory}" includes="${plugin.id}.jar"/>
			<!-- Also include dependencies from lib directory -->
			<zipfileset dir="lib" prefix="plugins/lib" erroronmissingdir="false">
				<include name="*.jar"/>
			</zipfileset>
		</zip>
		<echo message="Fallback zip created at: ${plugin.destination}/Manorrock-Assistant-Eclipse.zip"/>
		<exec executable="ls" failonerror="false">
			<arg value="-la"/>
			<arg value="${plugin.destination}"/>
		</exec>
	</target>
</project>
